{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "track",
    "global",
    "structure",
    "harmony",
    "audio_features",
    "interpretation",
    "provenance",
    "review"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "music-ir/0.1" },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_file", "duration_s", "analysis_mode"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "source_file": { "type": "string" },
        "duration_s": { "type": "number", "minimum": 0 },
        "analysis_mode": { "type": "string", "enum": ["full_mix", "stem", "solo"] }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempo_bpm", "key_summary", "key_candidates"],
      "properties": {
        "tempo_bpm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tool", "field", "value"],
                "properties": {
                  "tool": { "type": "string" },
                  "field": { "type": "string" },
                  "value": { "type": "number" }
                }
              }
            }
          }
        },
        "meter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "status"],
          "properties": {
            "value": { "type": "null" },
            "status": { "type": "string" }
          }
        },
        "key_summary": { "type": ["string", "null"] },
        "key_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "scale", "strength", "tool", "algorithm"],
            "properties": {
              "key": { "type": "string" },
              "scale": { "type": "string" },
              "strength": { "type": "number", "minimum": 0, "maximum": 1 },
              "tool": { "type": "string" },
              "algorithm": { "type": "string" }
            }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beats_s", "downbeats_s", "sections"],
      "properties": {
        "beats_s": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "downbeats_s": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_s", "end_s", "label", "tool"],
            "properties": {
              "start_s": { "type": "number", "minimum": 0 },
              "end_s": { "type": "number", "minimum": 0 },
              "label": { "type": "string" },
              "tool": { "type": "string" },
              "confidence": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "loudness_lufs": { "type": ["number", "null"] },
              "spectral_centroid_hz": { "type": ["number", "null"] },
              "dynamic_complexity": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "harmony": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_summary", "chord_statistics"],
      "properties": {
        "key_summary": { "type": ["string", "null"] },
        "chord_statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["histogram", "changes_rate", "source"],
          "properties": {
            "histogram": { "type": ["object", "array"] },
            "changes_rate": { "type": ["number", "null"] },
            "source": { "type": "string" }
          }
        },
        "time_aligned_chords": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "type": "string" }
          }
        }
      }
    },
    "audio_features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loudness_ebu128_integrated_lufs", "dynamic_complexity", "spectral_centroid_hz_mean"],
      "properties": {
        "loudness_ebu128_integrated_lufs": { "type": "number" },
        "loudness_range_lu": { "type": "number" },
        "dynamic_complexity": { "type": "number" },
        "spectral_centroid_hz_mean": { "type": "number" },
        "spectral_flux_mean": { "type": "number" },
        "onset_rate_per_s": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_notes", "derived_summary", "synthesis_hints"],
      "properties": {
        "manual_notes": { "type": "array", "items": { "type": "string" } },
        "derived_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "rule"],
          "properties": {
            "enabled": { "type": "boolean" },
            "rule": { "type": "string" }
          }
        },
        "synthesis_hints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "notes"],
          "properties": {
            "enabled": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allin1", "essentia", "created_at"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "allin1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "raw_json", "raw_sha256"],
          "properties": {
            "version": { "type": "string" },
            "raw_json": { "type": "string" },
            "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "essentia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "profile", "profile_sha256", "raw_json", "raw_sha256"],
          "properties": {
            "version": { "type": "string" },
            "profile": { "type": "string" },
            "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "raw_json": { "type": "string" },
            "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_checked"],
      "properties": {
        "human_checked": { "type": "boolean" },
        "known_uncertainties": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
